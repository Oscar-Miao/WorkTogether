# Copy to .env.local; pnpm setup can generate local-only credentials.
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://127.0.0.1:5173
# Leave empty for persistent local PGlite; use PostgreSQL in production.
DATABASE_URL=
TEAM_AGENT_SERVER_DATA_DIR=.local/server
TEAM_AGENT_BRIDGE_DATA_DIR=.local/bridge/default
OWNER_EMAIL=owner@team.local
OWNER_PASSWORD=replace-with-a-strong-local-password
NODE_ENV=development
# Default off: preview/holds remain available; enabling applies the cloud retention policy.
TEAM_AGENT_RETENTION_ENABLED=false
# Pi model credentials are read only by the local Bridge process.
PI_PROVIDER=anthropic
PI_MODEL=

# 团队账号配额；本机默认保留 10，企业容量仍需实际压测。
TEAM_AGENT_MEMBER_LIMIT=10
# 可选组织身份。仅关联已存在的团队账号，不自动加入其他项目。
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Goal understanding runs on the Owner server, separately from the Bridge's Pi model.
# Explicitly opt in; no model requests are made by the default rule observer.
COORDINATOR_ENABLED=false
COORDINATOR_BASE_URL=https://api.deepseek.com
COORDINATOR_MODEL=
COORDINATOR_API_KEY=

